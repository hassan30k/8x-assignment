# Optional: a light open-source LLM for free-form chat + product understanding.
# Works without it too (offline rule engine). Pick ONE provider:
#
# OpenRouter (free open-weights models, e.g. meta-llama/llama-3.3-70b-instruct:free)
#   get a free key at https://openrouter.ai/keys
#   OPENROUTER_API_KEY=sk-or-v1-...
#   LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Groq (free fast LLM API, llama-3.3-70b-versatile)
#   GROQ_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
#
# Any OpenAI-compatible endpoint
#   OPENAI_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# LLM_MODEL is optional and defaults per provider.